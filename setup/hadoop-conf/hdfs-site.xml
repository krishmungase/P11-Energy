<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <!-- Only one DataNode exists, so only one copy of each block can be stored -->
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>
  <!-- Default block size stays 128 MB. We override it for one upload in hdfs/hdfs_commands.sh -->
  <property>
    <name>dfs.blocksize</name>
    <value>134217728</value>
  </property>
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
</configuration>
